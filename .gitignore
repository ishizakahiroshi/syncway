# Local-only operational notes (server IPs, container names, paths, etc.)
docs/local/

# Claude Code / AI tool local settings (may contain tokens)
.claude/

# Local/private AI guidance & config (kept out of public clone)
*.local.md
*.local.json
*.local
*.local.*

# --- 認証情報・secrets・鍵（public へ絶対に出さない。Syncway は SSH 鍵を扱うツールなので最重要）---
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.env
.env.*
secrets.*
*.secret.*
*credential*
.netrc

# --- ログ・一時・生成物 ---
*.log
*.tmp
*.bak
*.orig
*.rej

# --- OS / エディタ ---
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# === ツール生成キャッシュ（アカウント ID 等の識別子を含み得る・追跡しない） ===
.wrangler/
.vercel/
.netlify/
.firebase/
.turbo/
.parcel-cache/
.terraform/
.serverless/
**/supabase/.temp/

# docsweep: backup snapshots (30-day retention, auto-cleanup)
.docsweep/

# 開発計画 md はすべて docs/local/archive/ 配下で管理する。
# リポ直下 archive/ へ置くと公開追跡されるため封をする（offline-md-editor-viewer ef29430 と同じ対処）。
/archive/
